# ResearchPilot Backend Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.

# Security Configuration
# IMPORTANT: Change to a strong random key in production (e.g., generated with openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Fallbacks to SQLite (sqlite:///./research_pilot.db) if left blank/commented out
# DATABASE_URL=postgresql://user:password@localhost:5432/research_pilot

# Vector DB & Storage Paths
CHROMA_DB_PATH=data/chroma_db
UPLOAD_DIR=data/uploads

# --- LLM Providers ---

# 1. Groq API (Primary LLM Provider)
# Set your Groq API Key to enable llama-3.3-70b-versatile
# If left blank, the application will run in simulated Mock Mode for testing
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# 4. Ollama (Local LLM Execution)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Email (SMTP) Configuration ---
# Used for password reset verification code emails.
# If SMTP_HOST is empty, verification OTP codes are logged to backend logs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=True

# --- Academic Discovery ---
SEMANTIC_SCHOLAR_API_KEY=
ACADEMIC_USER_AGENT=ResearchPilot/1.0 (mailto:researchpilot@example.com)
NEURIPS_PAPERS_URL=https://proceedings.neurips.cc/paper_files/paper/2025
ICML_PAPERS_URL=https://proceedings.mlr.press/v267/
ICLR_PAPERS_URL=https://openreview.net/group?id=ICLR.cc/2025/Conference
