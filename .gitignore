# ResearchPilot AI - Root .gitignore

# Environment files (sensitive credentials)
.env
.env.local
.env.*.local
*.env
backend/.env

# Dependencies & Package manager directories
node_modules/
jspm_packages/
web_stage/
venv/
.venv/
env/
ENV/
bin/
lib/
develop-eggs/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.eggs/
*.egg-info/
*.egg

# Python compilation and caching
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.ipynb_checkpoints

# Build directories & outputs
dist/
dist-ssr/
out/
.next/

# Local databases and SQLite files
*.db
*.sqlite
*.sqlite3
backend/research_pilot.db

# Application upload/storage data & vector stores
backend/data/uploads/
backend/data/vector_store/
backend/data/chroma_db/
data/uploads/
data/chroma_db/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/server.err.log
backend/server.out.log
frontend/server.err.log
frontend/server.out.log
backend/data/password_reset_otps.log

# IDEs, Editors & OS Files
.vscode/*
!.vscode/extensions.json
.idea/
.project
.classpath
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
